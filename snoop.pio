; snoop.pio
; push (tick, pins) to fifo on any change of the 32-bit pin field

.program snoop
	mov	y, pins
	mov     x, ~null
loop:
	jmp     x--, count
count:
	nop	[4]
	mov     isr, x
	mov     x, pins
	jmp     x!=y, changed
	mov     x, isr
	jmp     loop
changed:
	mov	y, x
	mov	x, isr
	push
	mov	isr, y
	push
	jmp     loop
